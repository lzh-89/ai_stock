# AI explanation layer.
# DeepSeek is supported through its OpenAI-compatible Chat Completions API.
AI_PROVIDER="deepseek"
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-v4-flash"
AI_BASE_URL="https://api.deepseek.com"

# Optional: use another OpenAI-compatible provider instead.
# AI_PROVIDER="custom"
# AI_API_KEY=""
# AI_MODEL=""
# AI_BASE_URL=""

# Optional: original OpenAI key fallback.
# AI_PROVIDER="openai"
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-5.4-mini"

TUSHARE_TOKEN=""

# Stock analysis case feedback loop.
# mode: off / preview / auto / on
STOCK_CASE_PROMPT_MODE="auto"
STOCK_CASE_PROMPT_MIN_SAMPLES="800"
STOCK_CASE_PROMPT_MIN_SIMILARITY="0.65"
STOCK_CASE_PROMPT_MIN_MATCHED_CASES="5"
STOCK_CASE_RECENT_FALSE_BUY_WINDOW="200"
STOCK_CASE_FALSE_BUY_ALLOWED_DEGRADE_POINTS="5"
STOCK_CASE_FALSE_BUY_ABSOLUTE_LIMIT_PCT="25"
STOCK_CASE_SUCCESS_3D_RETURN_PCT="3"
STOCK_CASE_SUCCESS_10D_RETURN_PCT="6"
STOCK_CASE_FALSE_BUY_RETURN_PCT="-3"
STOCK_CASE_FALSE_BUY_DRAWDOWN_PCT="-5"
STOCK_CASE_MISSED_5D_RETURN_PCT="5"
STOCK_CASE_DEDUPE_WINDOW_DAYS="5"
