<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ai-stock.stock-analysis-review</string>

  <key>ProgramArguments</key>
  <array>
    <string>__PROJECT_ROOT__/scripts/scheduled/run_stock_analysis_review.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>5</integer>
    <key>Hour</key>
    <integer>17</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>WorkingDirectory</key>
  <string>__PROJECT_ROOT__</string>

  <key>StandardOutPath</key>
  <string>__PROJECT_ROOT__/logs/launchd-stock-analysis-review.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>__PROJECT_ROOT__/logs/launchd-stock-analysis-review.stderr.log</string>
</dict>
</plist>
